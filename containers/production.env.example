# Copy this file to .env.production, replace every placeholder, and keep it private.
HENOSIS_IMAGE_REPOSITORY=ghcr.io/syntheos-systems/henosis
HENOSIS_IMAGE_DIGEST=REPLACE_WITH_64_CHARACTER_LOWERCASE_HEX_DIGEST
SYNTHEOS_ADDR=0.0.0.0:8088
SYNTHEOS_IDENTITY_DB=/var/lib/henosis/identity.sqlite
HENOSIS_APPROVAL_DB=/var/lib/henosis/approval.sqlite
HENOSIS_AUDIT_DB=/var/lib/henosis/audit.sqlite
SYNTHEOS_CHIASM_DB=/var/lib/henosis/chiasm.sqlite
SYNTHEOS_SOMA_DB=/var/lib/henosis/soma.sqlite
SYNTHEOS_BROCA_DB=/var/lib/henosis/broca.sqlite
SYNTHEOS_LOOM_DB=/var/lib/henosis/loom.sqlite
SYNTHEOS_THYMUS_DB=/var/lib/henosis/thymus.sqlite
SYNTHEOS_COGNITION_DB=/var/lib/henosis/cognition.db
HENOSIS_CRON_DIR=/var/lib/henosis/synapse-cron
SYNTHEOS_PLUTUS_DB=REPLACE_WITH_POSTGRES_CONNECTION_URI
SYNTHEOS_OPERATOR_JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
SYNTHEOS_OPERATOR_BOOTSTRAP_EMAIL=REPLACE_WITH_OWNER_EMAIL
SYNTHEOS_OPERATOR_BOOTSTRAP_PASSWORD=REPLACE_WITH_OWNER_CHOSEN_PASSWORD
HENOSIS_ROOM_MODE=required
HENOSIS_RIFT_DATABASE_URL=REPLACE_WITH_RIFT_POSTGRES_CONNECTION_URI
HENOSIS_RIFT_JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
HENOSIS_RIFT_BRIDGE_SECRET=REPLACE_WITH_DIFFERENT_AT_LEAST_64_RANDOM_HEX_CHARACTERS
HENOSIS_RIFT_BRIDGE_CONFIG=/run/secrets/henosis/agents.toml
ANTHROPIC_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
PHYLAXD_URL=https://phylaxd.example.invalid
HERMES_PHYLAXD_TOKEN=REPLACE_WITH_AT_LEAST_32_NON_WHITESPACE_CHARACTERS
HENOSIS_WITNESS_URL=https://witness.example.invalid
HENOSIS_AUDIT_ORIGIN_KEY_FILE=/run/secrets/henosis/audit-origin.key
HENOSIS_AUDIT_ORIGIN_KEY_ID=REPLACE_WITH_ORIGIN_KEY_ID
HENOSIS_WITNESS_PUBLIC_KEY_FILE=/run/secrets/henosis/witness-public.key
HENOSIS_WITNESS_KEY_ID=REPLACE_WITH_WITNESS_KEY_ID
