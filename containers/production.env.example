# Copy this file to .env.production, replace every placeholder, and keep it private.
# SYNTHEOS_* keys are canonical; legacy HENOSIS_* keys remain read-only
# compatibility aliases for a documented window.
SYNTHEOS_IMAGE_REPOSITORY=ghcr.io/syntheos-systems/henosis
SYNTHEOS_IMAGE_DIGEST=REPLACE_WITH_64_CHARACTER_LOWERCASE_HEX_DIGEST
SYNTHEOS_ADDR=0.0.0.0:8088
SYNTHEOS_IDENTITY_DB=/var/lib/henosis/identity.sqlite
SYNTHEOS_APPROVAL_DB=/var/lib/henosis/approval.sqlite
SYNTHEOS_AUDIT_DB=/var/lib/henosis/audit.sqlite
SYNTHEOS_CHIASM_DB=/var/lib/henosis/chiasm.sqlite
SYNTHEOS_SOMA_DB=/var/lib/henosis/soma.sqlite
SYNTHEOS_BROCA_DB=/var/lib/henosis/broca.sqlite
SYNTHEOS_LOOM_DB=/var/lib/henosis/loom.sqlite
SYNTHEOS_THYMUS_DB=/var/lib/henosis/thymus.sqlite
SYNTHEOS_COGNITION_DB=/var/lib/henosis/cognition.db
SYNTHEOS_CRON_DIR=/var/lib/henosis/synapse-cron
SYNTHEOS_PLUTUS_DB=REPLACE_WITH_POSTGRES_CONNECTION_URI
SYNTHEOS_OPERATOR_JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
SYNTHEOS_OPERATOR_BOOTSTRAP_EMAIL=REPLACE_WITH_OWNER_EMAIL
SYNTHEOS_OPERATOR_BOOTSTRAP_PASSWORD=REPLACE_WITH_OWNER_CHOSEN_PASSWORD
SYNTHEOS_ROOM_MODE=required
SYNTHEOS_RIFT_DATABASE_URL=REPLACE_WITH_RIFT_POSTGRES_CONNECTION_URI
SYNTHEOS_RIFT_JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
SYNTHEOS_RIFT_AGENT_JWT_SECRET=REPLACE_WITH_DIFFERENT_AGENT_ONLY_AT_LEAST_64_RANDOM_HEX_CHARACTERS
SYNTHEOS_RIFT_BRIDGE_SECRET=REPLACE_WITH_DIFFERENT_AT_LEAST_64_RANDOM_HEX_CHARACTERS
SYNTHEOS_RIFT_BRIDGE_CONFIG=/run/secrets/henosis/agents.toml
SYNTHEOS_RIFT_ADDR=0.0.0.0:3200
SYNTHEOS_RIFT_BRIDGE_ADDR=127.0.0.1:3201
SYNTHEOS_RIFT_ALLOW_REMOTE_LISTEN=1
SYNTHEOS_RIFT_CORS_ORIGINS=REPLACE_WITH_COMMA_SEPARATED_HTTPS_ORIGINS
ANTHROPIC_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
PHYLAXD_URL=https://phylaxd.example.invalid
HERMES_PHYLAXD_TOKEN=REPLACE_WITH_AT_LEAST_32_NON_WHITESPACE_CHARACTERS
SYNTHEOS_WITNESS_URL=https://witness.example.invalid
SYNTHEOS_AUDIT_ORIGIN_KEY_FILE=/run/secrets/henosis/audit-origin.key
SYNTHEOS_AUDIT_ORIGIN_KEY_ID=REPLACE_WITH_ORIGIN_KEY_ID
SYNTHEOS_WITNESS_PUBLIC_KEY_FILE=/run/secrets/henosis/witness-public.key
SYNTHEOS_WITNESS_KEY_ID=REPLACE_WITH_WITNESS_KEY_ID
